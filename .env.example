# ── Required ──────────────────────────────────────────────────────────────────

# Public URL of this instance (no trailing slash)
SMT_BASE_URL=http://localhost:8080

# 32-byte base64 master key for the secrets vault.
# Generate with: openssl rand -base64 32
SMT_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32

# Secret for signing session cookies.
# Generate with: openssl rand -hex 32
SMT_SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── Database ──────────────────────────────────────────────────────────────────

# Leave blank to use SQLite (stored at /data/smt.db — good for solo/dev).
# Set to a Postgres URL for team / production use.
# SMT_DB_URL=postgres://smt:smt@localhost:5432/smt

# ── Queue ─────────────────────────────────────────────────────────────────────

# Leave blank to use in-memory queue (single-node only).
# Set to a Redis URL for multi-node or persistent cron job queues.
# SMT_REDIS_URL=redis://localhost:6379

# ── Server ────────────────────────────────────────────────────────────────────

SMT_PORT=8080
SMT_HOST=0.0.0.0
SMT_LOG_LEVEL=info

# Max concurrent SSH sessions per user (default: 5)
# SMT_MAX_SSH_SESSIONS=5

# Max SFTP upload size in bytes (default: 1073741824 = 1 GiB)
# SMT_SFTP_MAX_UPLOAD_BYTES=1073741824

# Timeout for outbound AI API calls in milliseconds (default: 60000)
# SMT_AI_REQUEST_TIMEOUT=60000

# ── Health Monitoring ─────────────────────────────────────────────────────────

# Agentless SSH health checks. Runs in-process on an interval — no Redis needed.
# SMT_MONITORING_ENABLED=true

# Seconds between sweeps of the whole fleet (minimum 15, default 60)
# SMT_MONITORING_INTERVAL=60

# How many servers to probe in parallel (default: 5)
# SMT_MONITORING_CONCURRENCY=5

# Per-check SSH timeout in milliseconds (default: 20000)
# SMT_MONITORING_TIMEOUT=20000

# How long to keep metric samples, in hours (default: 168 = 7 days)
# SMT_MONITORING_RETENTION_HOURS=168

# Alert thresholds
# SMT_ALERT_CPU_PERCENT=90
# SMT_ALERT_MEMORY_PERCENT=90
# SMT_ALERT_DISK_PERCENT=90
# SMT_ALERT_LOAD_PER_CORE=2

# Consecutive failed checks before a server is alerted as down (default: 2)
# SMT_ALERT_OFFLINE_FAILURES=2

# ── OAuth / SSO (optional) ────────────────────────────────────────────────────

# SMT_OAUTH_GOOGLE_CLIENT_ID=
# SMT_OAUTH_GOOGLE_CLIENT_SECRET=

# SMT_OAUTH_GITHUB_CLIENT_ID=
# SMT_OAUTH_GITHUB_CLIENT_SECRET=

# SMT_OAUTH_GITLAB_CLIENT_ID=
# SMT_OAUTH_GITLAB_CLIENT_SECRET=
# SMT_OAUTH_GITLAB_BASE_URL=https://gitlab.com

# Generic OIDC (any OpenID Connect provider)
# SMT_OAUTH_OIDC_ISSUER=
# SMT_OAUTH_OIDC_CLIENT_ID=
# SMT_OAUTH_OIDC_CLIENT_SECRET=
