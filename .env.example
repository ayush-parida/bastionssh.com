# ── Required ──────────────────────────────────────────────────────────────────

# Public URL of this instance (no trailing slash)
SMT_BASE_URL=http://localhost:8080

# Master key for the secrets vault (base64, at least 32 characters). Keep it:
# stored credentials and backups cannot be decrypted without it.
# Generate with: openssl rand -base64 32
SMT_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32

# Secret for signing session cookies (at least 32 characters). Rotating it
# signs everyone out and invalidates backup codes.
# Generate with: openssl rand -hex 32
SMT_SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── Database ──────────────────────────────────────────────────────────────────

# Path of the SQLite database file (the only database supported).
# Default: /data/smt.db. Backups go to backups/ next to it unless SMT_BACKUP_DIR is set.
# SMT_DB_URL=./data/smt.db

# ── Queue ─────────────────────────────────────────────────────────────────────

# Redis for the job queue. Required for cron jobs to run on their schedule:
# without it there is no queue — saved commands and a cron job's "Run now" run
# in-process, but schedules are saved and never fire. (docker compose sets it.)
# SMT_REDIS_URL=redis://localhost:6379

# ── Server ────────────────────────────────────────────────────────────────────

SMT_PORT=8080
SMT_HOST=0.0.0.0
SMT_LOG_LEVEL=info

# Trust X-Forwarded-For from a reverse proxy (default: false — trust none).
# true = every hop, a number = that many hops, or a comma-separated IP/CIDR list.
# Required behind a reverse proxy (usually 1), or all users share the proxy's IP
# for rate limiting and the audit log. Only trust proxies you actually run.
# SMT_TRUST_PROXY=false

# This app's public IP, shown by connectivity diagnostics in firewall rules to
# paste ("Allow inbound TCP 22 from <ip>/32"). Unset = look it up from the IP
# echo services below (https only, first answer wins, cached 10 minutes); an IP
# = use it as-is (e.g. a NAT gateway the echo services cannot see); off = never
# look it up.
# SMT_EGRESS_IP=
# SMT_EGRESS_IP_SERVICES=https://api.ipify.org,https://ifconfig.me/ip

# ── Audit log forwarding ──────────────────────────────────────────────────────

# Syslog/webhook targets must resolve to public addresses. List private networks
# (IPs or CIDRs, comma-separated) a target may use, e.g. a collector on the LAN.
# Link-local and cloud-metadata addresses are refused regardless.
# SMT_AUDIT_FORWARD_ALLOW_NETS=10.20.0.0/16

# ── Passkeys (WebAuthn) ───────────────────────────────────────────────────────

# Browsers only offer passkeys on HTTPS pages or on localhost. A passkey is bound
# to the RP ID (a domain every allowed origin sits under) — changing it later
# makes existing passkeys unusable.
# SMT_WEBAUTHN_RP_ID=            # default: hostname of SMT_BASE_URL
# SMT_WEBAUTHN_RP_NAME=BastionSSH
# Comma-separated origins allowed to use passkeys (default: origin of SMT_BASE_URL;
# NODE_ENV=development also allows the Vite dev server at http://localhost:5173)
# SMT_WEBAUTHN_ORIGINS=

# ── First admin ───────────────────────────────────────────────────────────────

# Owner account created on first start when the database has no users.
# Leaving the password unset generates a random one, printed once to stderr —
# unless NODE_ENV is explicitly development/test (pnpm dev), where it is admin1234.
# SMT_ADMIN_EMAIL=ayush.parida@fgshq.com
# SMT_ADMIN_PASSWORD=

# Serve the built web app from this folder (the Docker image sets /app/apps/web/dist)
# SMT_STATIC_DIR=apps/web/dist

# ── Email (alerts and account notices) ───────────────────────────────────────

# Both or neither. Enables the Email notification channel and emails about new
# sign-in devices, sign-in lockouts, passkeys, backup codes and access requests.
# Invites are never emailed.
# SMT_SMTP_URL=smtp://user:password@smtp.example.com:587
# SMT_SMTP_FROM="BastionSSH <alerts@example.com>"

# ── Limits ────────────────────────────────────────────────────────────────────

# Max concurrent SSH sessions per user (default: 5). Not enforced yet.
# SMT_MAX_SSH_SESSIONS=5

# Max SFTP upload size in bytes (default: 1073741824 = 1 GiB)
# SMT_SFTP_MAX_UPLOAD_BYTES=1073741824

# Max object-storage (S3/MinIO) upload size in bytes (default: 5368709120 = 5 GiB)
# SMT_STORAGE_MAX_UPLOAD_BYTES=5368709120

# Max FTP/SFTP file-connection upload size in bytes (default: 1073741824 = 1 GiB)
# SMT_FTP_MAX_UPLOAD_BYTES=1073741824

# Max image archive size for Docker → Upload image, in bytes (default: 5368709120 = 5 GiB).
# The archive streams straight into the server's Docker Engine; nothing is stored on this host.
# A reverse proxy in front of BastionSSH needs a body limit at least this large (nginx: client_max_body_size),
# and for nginx also proxy_request_buffering off and a longer proxy_read_timeout (Docs → Upload image → Size limit).
# SMT_DOCKER_IMAGE_UPLOAD_MAX_BYTES=5368709120

# One SFTP request on a file connection (or a stalled transfer) may take this long, in ms (default: 30000)
# SMT_SFTP_OP_TIMEOUT_MS=30000

# Timeout for outbound AI API calls in milliseconds (default: 60000).
# Not applied yet: OpenAI and OpenAI-compatible calls use a fixed 60 s timeout,
# Anthropic calls the SDK's default.
# SMT_AI_REQUEST_TIMEOUT=60000

# ── Health Monitoring ─────────────────────────────────────────────────────────

# Agentless SSH health checks. Runs in-process on an interval — no Redis needed.
# SMT_MONITORING_ENABLED=true

# Seconds between sweeps of the whole fleet (minimum 15, default 60)
# SMT_MONITORING_INTERVAL=60

# How many servers to probe in parallel (default: 5)
# SMT_MONITORING_CONCURRENCY=5

# Per-check SSH timeout in milliseconds (default: 20000)
# SMT_MONITORING_TIMEOUT=20000

# How long to keep metric samples, in hours (default: 168 = 7 days)
# SMT_MONITORING_RETENTION_HOURS=168

# Alert thresholds
# SMT_ALERT_CPU_PERCENT=90
# SMT_ALERT_MEMORY_PERCENT=90
# SMT_ALERT_DISK_PERCENT=90
# SMT_ALERT_LOAD_PER_CORE=2

# Consecutive failed checks before a server is alerted as down (default: 2)
# SMT_ALERT_OFFLINE_FAILURES=2

# ── Cloud inventory sync ──────────────────────────────────────────────────────

# SMT_CLOUD_SYNC_ENABLED=true        # false = no scheduled sync (Sync now still works)
# SMT_CLOUD_SYNC_INTERVAL=15         # minutes between syncs (minimum 5)
# SMT_CLOUD_REQUEST_TIMEOUT=30000    # per-request provider timeout, ms

# ── App database backups ──────────────────────────────────────────────────────

# Online backups of the SQLite database (safe while the app runs). Also taken
# automatically before any upgrade migrates an existing database.
# SMT_BACKUP_DIR=                    # default: backups/ next to the database (/data/backups)
# SMT_BACKUP_INTERVAL_HOURS=24       # 0 = no scheduled backups
# SMT_BACKUP_KEEP=14                 # newest kept of each kind (scheduled, manual, …)
# SMT_BACKUP_GZIP=false
# SMT_BACKUP_PRE_MIGRATION=true      # false = migrate without a backup first

# Copy each scheduled/manual backup to an object-storage connection registered
# in the app (Storage page; its id is in the URL). Bucket is required with it.
# SMT_BACKUP_STORAGE_CONNECTION_ID=
# SMT_BACKUP_STORAGE_BUCKET=
# SMT_BACKUP_STORAGE_PREFIX=bastionssh-backups/

# ── Session Recording ─────────────────────────────────────────────────────────

# Terminal recordings (asciicast v2, gzipped when a session ends). On/off,
# keystroke capture and retention are per-organization settings in the UI.
# SMT_RECORDINGS_DIR=/data/recordings

# Cap per recording on the uncompressed cast, in bytes (default: 52428800 = 50 MiB)
# SMT_RECORDING_MAX_BYTES=52428800

# ── Single sign-on ────────────────────────────────────────────────────────────

# Per-organization OpenID Connect SSO is configured by owners in the app
# (Team & Access → Single sign-on), not here. The redirect URI to register at the
# provider is SMT_BASE_URL + /api/auth/sso/callback.
