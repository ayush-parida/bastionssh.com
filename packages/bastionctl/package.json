{
  "name": "@smt/bastionctl",
  "version": "0.1.0",
  "private": true,
  "description": "Runs deployments on a managed server: one zero-dependency file BastionSSH installs and verifies",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json --noEmit && node build.mjs",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "update-images": "node update-images.mjs"
  },
  "devDependencies": {
    "@smt/shared": "workspace:*",
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "yaml": "^2.9.1"
  }
}
