    // ─── Dev ──────────────────────────────────────────────────────────────────
    {
      "label": "Dev: All (full stack)",
      "type": "shell",
      "command": "pnpm dev",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "dev" },
      "isBackground": true,
      "problemMatcher": [],
      "windows": { "command": "pnpm dev" },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Dev: Server only",
      "type": "shell",
      "command": "pnpm --filter @smt/server dev",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "dev" },
